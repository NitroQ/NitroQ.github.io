---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../lib/site';

interface Props {
	post: CollectionEntry<'blog'>;
	rank: number;
}

const { post, rank } = Astro.props;
const { data } = post;

const date = data.pubDate.toLocaleDateString('en-GB', {
	year: 'numeric',
	month: 'short',
	day: '2-digit',
});
---

<!-- A high-score table entry: rank, title, score. -->
<article class="group relative border-b-2 border-line last:border-0">
	<a
		href={withBase(`/blog/${post.id}/`)}
		class="grid grid-cols-[auto_1fr] items-center gap-x-4 gap-y-2 px-2 py-5 transition-colors duration-100 hover:bg-ink-3 sm:grid-cols-[auto_1fr_auto] sm:gap-x-6"
	>
		<span
			class="display row-span-2 text-2xl text-line-2 transition-colors group-hover:text-amber sm:row-span-1"
		>
			{String(rank).padStart(2, '0')}
		</span>

		<span class="col-span-2 sm:col-span-1">
			<span
				class="display block text-[15px] text-paper transition-colors group-hover:text-amber"
			>
				{data.title}
			</span>
			<span class="muted mt-1 block max-w-2xl text-[15px] leading-snug">
				{data.description}
			</span>
		</span>

		<span class="col-start-2 flex items-center gap-4 sm:col-start-auto sm:flex-col sm:items-end sm:gap-1">
			<time datetime={data.pubDate.toISOString()} class="font-mono text-[11px] text-dim">
				{date}
			</time>
			<span class="font-mono text-[11px] text-phos">SCORE {data.score}</span>
		</span>
	</a>

	<ul class="flex flex-wrap gap-1.5 px-2 pb-4 sm:pl-16">
		{data.tags.map((tag) => <li class="chip">#{tag}</li>)}
	</ul>
</article>
