---
import { ACCENTS } from '../lib/accents';
import type { Experience } from '../lib/experience';
import PixelSprite from './PixelSprite.astro';

interface Props {
	entry: Experience;
	index?: number;
}

const { entry, index = 0 } = Astro.props;
const accent = ACCENTS[entry.accent];
---

<article class="panel pop relative p-6 md:p-8" style={`--shadow:${accent.bg.replace('bg-', '')}`}>
	<div class="flex flex-wrap items-start justify-between gap-4">
		<div class="flex items-start gap-4">
			<PixelSprite name={entry.sprite} size={34} class={accent.text} data-twitch />
			<div>
				<h3 class="display text-lg text-paper">{entry.role}</h3>
				<p class="mt-1 font-mono text-xs text-amber">{entry.org}</p>
			</div>
		</div>

		<div class="text-right font-mono text-[11px] text-dim">
			<p class={accent.text}>{entry.period}</p>
			<p>{entry.location}</p>
		</div>
	</div>

	<p class="muted mt-5 max-w-2xl leading-relaxed">{entry.summary}</p>

	<ul class="mt-5 space-y-2">
		{
			entry.highlights.map((point) => (
				<li class="flex gap-3 text-[15px] leading-relaxed">
					<span class={`mt-2 size-1.5 shrink-0 ${accent.bg}`} aria-hidden="true" />
					<span class="muted">{point}</span>
				</li>
			))
		}
	</ul>

	<ul class="mt-6 flex flex-wrap gap-1.5">
		{entry.stack.map((tech) => <li class="chip">{tech}</li>)}
	</ul>
</article>