---
import type { PaletteItem } from '../lib/site';

interface Props {
	items: PaletteItem[];
}

const { items } = Astro.props;
---

<div
	class="palette-backdrop"
	data-palette
	hidden
	role="dialog"
	aria-modal="true"
	aria-label="Command palette"
>
	<div class="panel w-full max-w-lg overflow-hidden !border-line-2">
		<div class="flex items-center gap-3 border-b-2 border-line px-4 py-3">
			<span class="font-mono text-xs text-amber">&gt;</span>
			<input
				type="text"
				data-palette-input
				placeholder="SEARCH…"
				autocomplete="off"
				spellcheck="false"
				aria-label="Search pages, projects and posts"
				class="w-full bg-transparent font-mono text-sm text-paper outline-none placeholder:text-dim"
			/>
			<kbd class="chip">ESC</kbd>
		</div>

		<nav
			data-palette-list
			aria-label="Results"
			class="max-h-[52vh] overflow-y-auto p-2"
		>
		</nav>

		<div
			class="flex items-center gap-4 border-t-2 border-line px-4 py-2 font-mono text-[10px] text-dim"
		>
			<span>↑↓ MOVE</span>
			<span>⏎ OPEN</span>
			<span class="ml-auto">NITROQ.OS</span>
		</div>
	</div>
</div>

<script
	type="application/json"
	id="palette-data"
	is:inline
	set:html={JSON.stringify(items)}
/>
