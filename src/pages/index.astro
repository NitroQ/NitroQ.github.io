---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostRow from '../components/PostRow.astro';
import SectionTitle from '../components/SectionTitle.astro';
import Marquee from '../components/Marquee.astro';
import PixelSprite from '../components/PixelSprite.astro';
import { HERO, SKILLS, SITE, withBase } from '../lib/site';

const projects = (await getCollection('projects')).sort(
	(a, b) => a.data.order - b.data.order,
);
const featured = projects.filter((p) => p.data.featured);
const rest = projects.filter((p) => !p.data.featured).slice(0, 3);

const posts = (await getCollection('blog', ({ data }) => !data.draft))
	.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
	.slice(0, 4);
---

<BaseLayout>
	<!-- ============================ HERO ============================ -->
	<section class="relative overflow-hidden border-b-2 border-line">
		<!-- Dithered dawn behind the cabinet. -->
		<div
			class="dither dither-75 pointer-events-none absolute -top-24 -right-24 size-[420px] text-violet/25"
			aria-hidden="true"
		>
		</div>
		<div
			class="dither dither-50 pointer-events-none absolute -bottom-32 -left-32 size-[380px] text-hot/20"
			aria-hidden="true"
		>
		</div>

		<div
			class="shell relative grid items-center gap-12 py-16 lg:grid-cols-[1.15fr_0.85fr] lg:py-24"
		>
			<div>
				<p class="eyebrow flex items-center gap-2" data-reveal data-enter>
					<PixelSprite name="coin" size={12} class="bob" />
					{HERO.eyebrow} — 1P
				</p>

				<h1
					class="display mt-6 text-[clamp(2.6rem,12vw,6.5rem)]"
					aria-label="Frank Gesmundo"
					data-reveal
					data-enter
				>
					<span
						class="block text-paper"
						data-decode
						data-text="FRANK"
						aria-hidden="true">FRANK</span
					>
					<span
						class="block text-hot"
						data-decode
						data-text="GESMUNDO"
						aria-hidden="true">GESMUNDO</span
					>
				</h1>

				<p class="lede mt-7 max-w-xl" data-reveal data-enter>
					{HERO.blurb}
				</p>

				<div class="mt-9 flex flex-wrap gap-3" data-reveal data-enter>
					<a href={withBase('/projects/')} class="btn btn-primary">
						<PixelSprite name="star" size={12} />
						View projects
					</a>
					<a href={withBase('/blog/')} class="btn">
						<PixelSprite name="chip" size={12} />
						Read the blog
					</a>
				</div>

				<dl
					class="mt-12 grid max-w-lg grid-cols-3 gap-px border-2 border-line bg-line"
					data-reveal
					data-enter
				>
					{
						HERO.stats.map((stat) => (
							<div class="bg-ink-2 px-4 py-3">
								<dt class="font-mono text-[10px] tracking-[0.14em] text-dim uppercase">
									{stat.label}
								</dt>
								<dd class="display mt-1 text-2xl text-phos">{stat.value}</dd>
							</div>
						))
					}
				</dl>
			</div>

			<!-- The cabinet itself. -->
			<div class="panel relative p-5" data-reveal data-enter>
				<div class="flex items-center justify-between">
					<span class="eyebrow">CABINET 01</span>
					<span class="font-mono text-[10px] text-phos">CREDIT 01</span>
				</div>

				<div
					class="relative mt-4 overflow-hidden border-2 border-line-2 bg-ink"
					style="aspect-ratio: 4 / 3;"
				>
					<div
						class="dither dither-75 absolute inset-x-0 bottom-0 h-1/2 text-cyan/15"
						aria-hidden="true"
					>
					</div>

					<PixelSprite
						name="crab"
						size={88}
						class="bob absolute bottom-8 left-1/2 -translate-x-1/2"
						data-twitch
					/>

					<div
						class="absolute inset-x-0 bottom-3 flex justify-center gap-2"
						aria-hidden="true"
					>
						{[0, 1, 2, 3, 4].map((i) => (
							<PixelSprite
								name="coin"
								size={12}
								class={i > 1 ? 'opacity-30' : ''}
							/>
						))}
					</div>

					<p
						class="display absolute top-3 left-1/2 -translate-x-1/2 text-[10px] tracking-[0.28em] text-amber blink"
					>
						INSERT COIN
					</p>
				</div>

				<div
					class="mt-4 flex items-center justify-between font-mono text-[10px] text-dim"
				>
					<span>{SITE.location}</span>
					<span class="text-phos">ONLINE</span>
				</div>
			</div>
		</div>
	</section>

	<Marquee tone="amber" />

	<!-- ========================= FEATURED ========================== -->
	<section class="shell py-20">
		<SectionTitle label="Featured" sprite="star" />
		<div class="grid gap-5 md:grid-cols-2" data-reveal-group>
			{featured.map((project) => <ProjectCard project={project} />)}
		</div>
	</section>

	<!-- ========================== MORE ============================= -->
	<section class="shell pb-20">
		<div class="mb-7 flex items-end justify-between gap-6">
			<SectionTitle label="More work" sprite="chip" />
			<a
				href={withBase('/projects/')}
				class="display shrink-0 text-[11px] text-amber transition-colors hover:text-phos"
			>
				VIEW ALL {projects.length} →
			</a>
		</div>

		<div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3" data-reveal-group>
			{rest.map((project) => <ProjectCard project={project} />)}
		</div>
	</section>

	<!-- ========================== POSTS ============================ -->
	<section class="border-y-2 border-line bg-ink-2 py-20">
		<div class="shell">
			<SectionTitle label="High scores" sprite="bolt" title="From the notebook" />

			<div class="border-t-2 border-line" data-reveal>
				{posts.map((post, i) => <PostRow post={post} rank={i + 1} />)}
			</div>
		</div>
	</section>

	<!-- ========================== LOADOUT ========================== -->
	<section class="shell py-20">
		<SectionTitle label="Loadout" sprite="chip" title="What I build with" />

		<div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4" data-reveal-group>
			{
				SKILLS.map((skill) => (
					<div class="panel p-5">
						<div class="flex items-center gap-3">
							<PixelSprite name={skill.sprite} size={22} data-twitch />
							<h3 class="display text-[13px] tracking-[0.1em] text-amber">
								{skill.group.toUpperCase()}
							</h3>
						</div>
						<ul class="mt-4 flex flex-wrap gap-1.5">
							{skill.items.map((item) => (
								<li class="chip">{item}</li>
							))}
						</ul>
					</div>
				))
			}
		</div>
	</section>

	<!-- =========================== CTA ============================= -->
	<section class="shell pb-8">
		<div
			class="panel relative overflow-hidden p-10 text-center md:p-16"
			data-reveal
		>
			<div
				class="dither dither-50 pointer-events-none absolute inset-0 text-amber/10"
				aria-hidden="true"
			>
			</div>

			<PixelSprite name="heart" size={28} class="mx-auto" data-twitch />
			<h2 class="display mt-5 text-[clamp(1.5rem,5vw,2.6rem)]">
				CONTINUE?
			</h2>
			<p class="lede muted mx-auto mt-4 max-w-lg">
				Everything here is open source and free to run. If something looks
				interesting, the source is one click away.
			</p>
			<div class="mt-8 flex flex-wrap justify-center gap-3">
				<a
					href={`https://github.com/${SITE.githubUser}`}
					target="_blank"
					rel="me noopener noreferrer"
					class="btn btn-primary"
				>
					<PixelSprite name="coin" size={12} />
					GitHub profile
				</a>
				<a href={withBase('/about/')} class="btn">More about me</a>
			</div>
		</div>
	</section>
</BaseLayout>
