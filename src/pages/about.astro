---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import PixelSprite from '../components/PixelSprite.astro';
import Marquee from '../components/Marquee.astro';
import { SITE, SKILLS, withBase } from '../lib/site';
import { WORK } from '../lib/experience';
---

<BaseLayout
	title="About"
	description="Frank Gesmundo is a full stack mobile and web developer in Rodriguez, Philippines, building offline-first desktop and web software."
>
	<section class="border-b-2 border-line bg-ink-2">
		<div class="shell grid gap-12 py-16 lg:grid-cols-[1.2fr_0.8fr]">
			<div>
				<p class="eyebrow" data-reveal data-enter>PLAYER PROFILE</p>
				<h1
					class="display mt-4 text-[clamp(2.2rem,8vw,4rem)]"
					aria-label="About Frank Gesmundo"
					data-reveal
					data-enter
				>
					<span data-decode data-text="ABOUT" aria-hidden="true">ABOUT</span>
				</h1>

				<div class="lede mt-8 space-y-5" data-reveal data-enter>
					<p>
					I'm <strong class="text-phos">{SITE.fullName}</strong> — a full
					stack web and mobile developer, UI/UX designer and IT
					administrator based in {SITE.location}. I've been shipping
					software since 2016, and the thing I keep coming back to is the
					same: build things that respect the person using them.
				</p>
				<p>
					My work sits across three layers that usually belong to three
					people: the <strong class="text-phos">interface</strong>, the
					<strong class="text-phos">application</strong>, and the
					<strong class="text-phos">infrastructure</strong> under it. A
					studio's network and servers, an intern's Laravel app in
					production, a Flutter build, and the Figma file that decided how
					any of it should look. I like being the person who does not have
					to hand it off.
				</p>
				<p>
					Day to day that means Laravel and PHP for the web, Flutter and
					Java for mobile, and MySQL or MongoDB behind it. Before that:
					ASP.NET MVC, Spring Boot, Angular, and a lot of Java Swing. The
					constant is <strong class="text-phos">shipping</strong> — scoping
					it, building it, documenting it, and handing it over so somebody
					else can maintain it.
				</p>
				</div>
			</div>

			<div class="panel h-fit p-6" data-reveal data-enter>
				<PixelSprite name="crab" size={56} class="bob mx-auto" />

				<dl class="mt-6 space-y-3 font-mono text-xs">
					<div class="flex justify-between gap-4 border-b-2 border-line pb-3">
						<dt class="text-dim">HANDLE</dt>
						<dd class="text-paper">@{SITE.githubUser}</dd>
					</div>
					<div class="flex justify-between gap-4 border-b-2 border-line pb-3">
						<dt class="text-dim">ROLE</dt>
						<dd class="text-right text-paper">{SITE.role}</dd>
					</div>
					<div class="flex justify-between gap-4 border-b-2 border-line pb-3">
						<dt class="text-dim">ALSO</dt>
						<dd class="text-right text-paper">{SITE.tags.join(' · ')}</dd>
					</div>
					<div class="flex justify-between gap-4 border-b-2 border-line pb-3">
						<dt class="text-dim">BASED IN</dt>
						<dd class="text-paper">{SITE.location}</dd>
					</div>
					<div class="flex justify-between gap-4 border-b-2 border-line pb-3">
						<dt class="text-dim">SINCE</dt>
						<dd class="text-paper">2016</dd>
					</div>
					<div class="flex justify-between gap-4">
						<dt class="text-dim">STATUS</dt>
						<dd class="flex items-center gap-2 text-phos">
							<span class="blink inline-block size-2 bg-phos"></span>
							OPEN TO WORK
						</dd>
					</div>
				</dl>

				<div class="mt-6 flex flex-wrap gap-2">
					{
						SITE.social.map((item) => (
							<a
								href={item.href}
								target="_blank"
								rel="me noopener noreferrer"
								class="btn !px-3 !py-2 !text-[10px]"
							>
								{item.label} ↗
							</a>
						))
					}
				</div>
			</div>
		</div>
	</section>

	<section class="shell py-20">
		<SectionTitle label="Career log" sprite="chip" title="Experience" />

		<ol class="relative space-y-8 border-l-2 border-line pl-8" data-reveal-group>
			{
				WORK.map((entry) => (
					<li class="relative" data-reveal>
						<span class="absolute top-2 -left-[41px] size-4 border-2 border-amber bg-ink" />
						<p class="font-mono text-[11px] tracking-[0.12em] text-amber">
							{entry.period}
						</p>
						<h3 class="display mt-2 text-lg text-paper">{entry.role}</h3>
						<p class="mt-1 font-mono text-xs text-dim">{entry.org}</p>
						<p class="muted mt-2 max-w-2xl leading-relaxed">{entry.summary}</p>
					</li>
				))
			}
		</ol>

		<a href={withBase('/experience/')} class="btn btn-primary mt-10">
			<PixelSprite name="coin" size={12} />
			Full career log
		</a>
	</section>

	<section class="border-y-2 border-line bg-ink-2 py-20">
		<div class="shell">
			<SectionTitle label="Loadout" sprite="chip" title="Skills" />
			<div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4" data-reveal-group>
				{
					SKILLS.map((skill) => (
						<div class="panel p-5">
							<div class="flex items-center gap-3">
								<PixelSprite name={skill.sprite} size={22} data-twitch />
								<h3 class="display text-[13px] tracking-[0.1em] text-amber">
									{skill.group.toUpperCase()}
								</h3>
							</div>
							<ul class="mt-4 flex flex-wrap gap-1.5">
								{skill.items.map((item) => (
									<li class="chip">{item}</li>
								))}
							</ul>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section class="shell py-20">
		<SectionTitle label="Next" sprite="star" title="What happens next" />

		<div class="grid gap-5 md:grid-cols-3" data-reveal-group>
			{
				[
					{
					sprite: 'bolt',
					title: 'Finishing things',
					body: 'Fifteen projects, seven roles, two studios and a thesis. The pattern that keeps repeating is finishing — and documenting so the next person can pick it up.',
				},
					{
						sprite: 'chip',
						title: 'Writing more',
						body: 'The notebook is new. Architecture notes, post-mortems, and the occasional strong opinion about developer experience.',
					},
					{
			sprite: 'heart',
			title: 'Available for work',
			body: 'Open to full stack, mobile and UI/UX roles — and to projects that care about the person on the other side of the screen.',
		},
				].map((card) => (
					<div class="panel p-6">
						<PixelSprite name={card.sprite} size={24} data-twitch />
						<h3 class="display mt-4 text-base text-paper">{card.title}</h3>
						<p class="muted mt-2 text-[15px] leading-relaxed">{card.body}</p>
					</div>
				))
			}
		</div>
	</section>

	<Marquee />
</BaseLayout>
