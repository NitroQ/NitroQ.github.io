---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import PixelSprite from '../components/PixelSprite.astro';
import Marquee from '../components/Marquee.astro';
import { SITE, SKILLS, TIMELINE, withBase } from '../lib/site';
---

<BaseLayout
	title="About"
	description="Frank Gesmundo is a full stack mobile and web developer in Rodriguez, Philippines, building offline-first desktop and web software."
>
	<section class="border-b-2 border-line bg-ink-2">
		<div class="shell grid gap-12 py-16 lg:grid-cols-[1.2fr_0.8fr]">
			<div>
				<p class="eyebrow" data-reveal data-enter>PLAYER PROFILE</p>
				<h1
					class="display mt-4 text-[clamp(2.2rem,8vw,4rem)]"
					aria-label="About Frank Gesmundo"
					data-reveal
					data-enter
				>
					<span data-decode data-text="ABOUT" aria-hidden="true">ABOUT</span>
				</h1>

				<div class="lede mt-8 space-y-5" data-reveal data-enter>
					<p>
						I'm <strong class="text-phos">Frank Gesmundo</strong> — a full
						stack mobile and web developer based in
						{SITE.location}. I've been shipping software since 2017, and the
						thing I keep coming back to is the same: build things that respect
						the person using them.
					</p>
					<p>
						Most of my recent work is <strong class="text-phos">local-first</strong>.
						That means the data lives on your machine, the app works with the
						wifi off, and there is no server holding a copy of your life. It's
						a technical choice, but it's really a stance — if a product needs a
						behavioural advertising company to stay solvent, it is not built
						well.
					</p>
					<p>
						Day to day that means Rust and Tauri for desktop, Laravel for
						services, TypeScript everywhere else. Before that: Java, PHP,
						Angular, and a lot of Swing.
					</p>
				</div>
			</div>

			<div class="panel h-fit p-6" data-reveal data-enter>
				<PixelSprite name="crab" size={56} class="bob mx-auto" />

				<dl class="mt-6 space-y-3 font-mono text-xs">
					<div class="flex justify-between gap-4 border-b-2 border-line pb-3">
						<dt class="text-dim">HANDLE</dt>
						<dd class="text-paper">@{SITE.githubUser}</dd>
					</div>
					<div class="flex justify-between gap-4 border-b-2 border-line pb-3">
						<dt class="text-dim">ROLE</dt>
						<dd class="text-right text-paper">{SITE.role}</dd>
					</div>
					<div class="flex justify-between gap-4 border-b-2 border-line pb-3">
						<dt class="text-dim">BASED IN</dt>
						<dd class="text-paper">{SITE.location}</dd>
					</div>
					<div class="flex justify-between gap-4 border-b-2 border-line pb-3">
						<dt class="text-dim">SINCE</dt>
						<dd class="text-paper">2017</dd>
					</div>
					<div class="flex justify-between gap-4">
						<dt class="text-dim">STATUS</dt>
						<dd class="flex items-center gap-2 text-phos">
							<span class="blink inline-block size-2 bg-phos"></span>
							OPEN TO WORK
						</dd>
					</div>
				</dl>

				<div class="mt-6 flex flex-wrap gap-2">
					{
						SITE.social.map((item) => (
							<a
								href={item.href}
								target="_blank"
								rel="me noopener noreferrer"
								class="btn !px-3 !py-2 !text-[10px]"
							>
								{item.label} ↗
							</a>
						))
					}
				</div>
			</div>
		</div>
	</section>

	<section class="shell py-20">
		<SectionTitle label="History" sprite="chip" title="Chapters" />

		<ol class="relative space-y-8 border-l-2 border-line pl-8" data-reveal-group>
			{
				TIMELINE.map((entry) => (
					<li class="relative" data-reveal>
						<span class="absolute top-2 -left-[41px] size-4 border-2 border-amber bg-ink" />
						<p class="font-mono text-[11px] tracking-[0.12em] text-amber">
							{entry.period}
						</p>
						<h3 class="display mt-2 text-lg text-paper">{entry.title}</h3>
						<p class="muted mt-2 max-w-2xl leading-relaxed">{entry.body}</p>
					</li>
				))
			}
		</ol>
	</section>

	<section class="border-y-2 border-line bg-ink-2 py-20">
		<div class="shell">
			<SectionTitle label="Loadout" sprite="chip" title="Skills" />
			<div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4" data-reveal-group>
				{
					SKILLS.map((skill) => (
						<div class="panel p-5">
							<div class="flex items-center gap-3">
								<PixelSprite name={skill.sprite} size={22} data-twitch />
								<h3 class="display text-[13px] tracking-[0.1em] text-amber">
									{skill.group.toUpperCase()}
								</h3>
							</div>
							<ul class="mt-4 flex flex-wrap gap-1.5">
								{skill.items.map((item) => (
									<li class="chip">{item}</li>
								))}
							</ul>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section class="shell py-20">
		<SectionTitle label="Next" sprite="star" title="What happens next" />

		<div class="grid gap-5 md:grid-cols-3" data-reveal-group>
			{
				[
					{
						sprite: 'bolt',
						title: 'Finishing Bea',
						body: 'Bea is the most ambitious thing I have built. Making local inference feel instant on ordinary hardware is the whole game.',
					},
					{
						sprite: 'chip',
						title: 'Writing more',
						body: 'The notebook is new. Architecture notes, post-mortems, and the occasional strong opinion about developer experience.',
					},
					{
						sprite: 'heart',
						title: 'Available for work',
						body: 'Open to full stack and desktop roles, and to projects that care about where the data lives.',
					},
				].map((card) => (
					<div class="panel p-6">
						<PixelSprite name={card.sprite} size={24} data-twitch />
						<h3 class="display mt-4 text-base text-paper">{card.title}</h3>
						<p class="muted mt-2 text-[15px] leading-relaxed">{card.body}</p>
					</div>
				))
			}
		</div>
	</section>

	<Marquee />
</BaseLayout>
