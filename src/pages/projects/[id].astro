---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import PixelSprite from '../../components/PixelSprite.astro';
import { ACCENTS } from '../../lib/accents';
import { repoMeta } from '../../lib/github';
import { withBase } from '../../lib/site';

export async function getStaticPaths() {
	const projects = await getCollection('projects');
	return projects.map((project) => ({
		params: { id: project.id },
		props: { project },
	}));
}

const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);

const accent = ACCENTS[data.accent];
const meta = repoMeta(data.repo);

const STATUS = {
	active: { label: 'IN DEVELOPMENT', tone: 'text-hot border-hot' },
	stable: { label: 'SHIPPED', tone: 'text-phos border-phos' },
	archived: { label: 'RETIRED', tone: 'text-dim border-line-2' },
} as const;
const status = STATUS[data.status];

const all = (await getCollection('projects')).sort(
	(a, b) => a.data.order - b.data.order,
);
const index = all.findIndex((p) => p.id === project.id);
const next = all[(index + 1) % all.length];
---

<BaseLayout title={data.title} description={data.summary}>
	<article>
		<header class="border-b-2 border-line bg-ink-2">
			<div class="shell py-14">
				<a
					href={withBase('/projects/')}
					class="font-mono text-[11px] text-dim transition-colors hover:text-amber"
				>
					← ALL PROJECTS
				</a>

				<div class="mt-8 flex flex-wrap items-start justify-between gap-8">
					<div class="max-w-2xl">
						<div class="flex items-center gap-4">
							<PixelSprite name={data.sprite} size={44} class={accent.text} data-twitch />
							<span
								class:list={[
									'font-mono text-[10px] tracking-[0.14em] border px-2 py-1',
									status.tone,
								]}
							>
								{status.label}
							</span>
						</div>

						<h1
							class="display mt-6 text-[clamp(2rem,7vw,3.6rem)]"
							aria-label={data.title}
							data-reveal
							data-enter
						>
							<span data-decode data-text={data.title.toUpperCase()} aria-hidden="true">
								{data.title.toUpperCase()}
							</span>
						</h1>

						<p class="lede muted mt-5">{data.summary}</p>
					</div>

					<div class="flex flex-wrap gap-3">
						<a
							href={`https://github.com/NitroQ/${data.repo}`}
							target="_blank"
							rel="noopener noreferrer"
							class="btn btn-primary"
						>
							<PixelSprite name="coin" size={12} />
							Source code
						</a>
						{
							data.demo && (
								<a
									href={data.demo}
									target="_blank"
									rel="noopener noreferrer"
									class="btn"
								>
									Live demo ↗
								</a>
							)
						}
					</div>
				</div>

				<dl
					class="mt-12 grid grid-cols-2 gap-px border-2 border-line bg-line sm:grid-cols-4"
					data-reveal
				>
					<div class="bg-ink-2 px-4 py-3">
						<dt class="font-mono text-[10px] tracking-[0.14em] text-dim uppercase">Year</dt>
						<dd class="display mt-1 text-lg text-paper">{data.year}</dd>
					</div>
					<div class="bg-ink-2 px-4 py-3">
						<dt class="font-mono text-[10px] tracking-[0.14em] text-dim uppercase">
							Language
						</dt>
						<dd class="display mt-1 text-lg text-paper">
							{meta?.language ?? data.stack[0] ?? '—'}
						</dd>
					</div>
					<div class="bg-ink-2 px-4 py-3">
						<dt class="font-mono text-[10px] tracking-[0.14em] text-dim uppercase">Stars</dt>
						<dd class="display mt-1 text-lg text-phos">{meta?.stars ?? 0}</dd>
					</div>
					<div class="bg-ink-2 px-4 py-3">
						<dt class="font-mono text-[10px] tracking-[0.14em] text-dim uppercase">
							Licence
						</dt>
						<dd class="display mt-1 text-lg text-paper">
							{data.license ?? meta?.license ?? '—'}
						</dd>
					</div>
				</dl>
			</div>
		</header>

		<div class="shell grid gap-12 py-16 lg:grid-cols-[1fr_260px]">
			<div class="prose-arcade" data-reveal>
				<Content />
			</div>

			<aside class="lg:sticky lg:top-28 lg:self-start">
				<div class="panel p-5" data-reveal>
					<h2 class="eyebrow mb-4">Stack</h2>
					<ul class="flex flex-wrap gap-1.5">
						{data.stack.map((tech) => <li class="chip chip-accent">{tech}</li>)}
					</ul>
				</div>

				{
					meta && meta.topics.length > 0 && (
						<div class="panel mt-4 p-5" data-reveal>
							<h2 class="eyebrow mb-4">Repository topics</h2>
							<ul class="flex flex-wrap gap-1.5">
								{meta.topics.slice(0, 8).map((topic) => (
									<li class="chip">#{topic}</li>
								))}
							</ul>
						</div>
					)
				}

				<div class="panel mt-4 p-5" data-reveal>
					<h2 class="eyebrow mb-3">Repository</h2>
					<a
						href={`https://github.com/NitroQ/${data.repo}`}
						target="_blank"
						rel="noopener noreferrer"
						class="font-mono text-xs break-all text-cyan hover:text-phos"
					>
						github.com/NitroQ/{data.repo}
					</a>
				</div>
			</aside>
		</div>
	</article>

	<!-- Next project -->
	<section class="border-t-2 border-line bg-ink-2 py-14">
		<div class="shell" data-reveal>
			<p class="eyebrow mb-6">Next slot</p>
			<div class="max-w-md">
				<ProjectCard project={next!} />
			</div>
		</div>
	</section>
</BaseLayout>
