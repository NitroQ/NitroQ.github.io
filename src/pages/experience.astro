---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExperienceCard from '../components/ExperienceCard.astro';
import SectionTitle from '../components/SectionTitle.astro';
import PixelSprite from '../components/PixelSprite.astro';
import Marquee from '../components/Marquee.astro';
import { AWARDS, CURRENT_ROLES, EDUCATION, SINCE, WORK } from '../lib/experience';
import { profilePageSchema } from '../lib/seo';
import { SITE, withBase } from '../lib/site';

const years = new Date().getFullYear() - SINCE;
---

<BaseLayout
	title="Experience"
	description={`Where ${SITE.fullName} has worked — ${WORK.length} roles across web development, mobile apps, UI/UX design and IT administration since ${SINCE}.`}
	schema={[
		profilePageSchema(Astro.url.href),
		...AWARDS.map((award) => ({
			'@type': 'Award',
			name: award.title,
			description: award.note ?? award.issuer,
			dateCreated: award.year,
			awardReceived: award.issuer,
		})),
	]}
>
	<section class="border-b-2 border-line bg-ink-2">
		<div class="shell py-16">
			<p class="eyebrow" data-reveal data-enter>CAREER LOG</p>
			<h1
				class="display mt-4 text-[clamp(2.2rem,9vw,4.5rem)]"
				aria-label="Experience"
				data-reveal
				data-enter
			>
				<span data-decode data-text="EXPERIENCE" aria-hidden="true">EXPERIENCE</span>
			</h1>
			<p class="lede muted mt-6 max-w-2xl" data-reveal data-enter>
				{years} years, {WORK.length} roles. Web, mobile, design and the network
				plumbing underneath — the throughline is always the same: make software
				that respects the person on the other side of the screen.
			</p>

			<dl class="mt-10 grid grid-cols-2 gap-px border-2 border-line bg-line sm:grid-cols-4" data-reveal data-enter>
				<div class="bg-ink-2 px-4 py-3">
					<dt class="font-mono text-[10px] tracking-[0.14em] text-dim uppercase">Years</dt>
					<dd class="display mt-1 text-2xl text-phos">{years}</dd>
				</div>
				<div class="bg-ink-2 px-4 py-3">
					<dt class="font-mono text-[10px] tracking-[0.14em] text-dim uppercase">Roles</dt>
					<dd class="display mt-1 text-2xl text-phos">{WORK.length}</dd>
				</div>
				<div class="bg-ink-2 px-4 py-3">
					<dt class="font-mono text-[10px] tracking-[0.14em] text-dim uppercase">Current</dt>
					<dd class="display mt-1 text-2xl text-phos">{CURRENT_ROLES}</dd>
				</div>
				<div class="bg-ink-2 px-4 py-3">
					<dt class="font-mono text-[10px] tracking-[0.14em] text-dim uppercase">Awards</dt>
					<dd class="display mt-1 text-2xl text-amber">{AWARDS.length}</dd>
				</div>
			</dl>
		</div>
	</section>

	<section class="shell py-20">
		<SectionTitle label="Where I have worked" sprite="chip" title="Work" />

		<div class="grid gap-6" data-reveal-group>
			{WORK.map((entry) => <ExperienceCard entry={entry} />)}
		</div>
	</section>

	<section class="border-y-2 border-line bg-ink-2 py-20">
		<div class="shell">
			<SectionTitle label="Credentials" sprite="star" title="Education" />

			<div class="grid gap-6 lg:grid-cols-2" data-reveal-group>
				{
					EDUCATION.map((entry) => (
						<div class="panel p-6 md:p-8">
							<div class="flex flex-wrap items-start justify-between gap-4">
								<div class="flex items-start gap-4">
									<PixelSprite name="ghost" size={34} class="text-violet" data-twitch />
									<div>
										<h3 class="display text-base text-paper">{entry.degree}</h3>
										<p class="mt-1 font-mono text-xs text-amber">{entry.school}</p>
									</div>
								</div>
								<div class="text-right font-mono text-[11px] text-dim">
									<p class="text-violet">{entry.period}</p>
									<p>{entry.location}</p>
								</div>
							</div>

							{entry.honours.length > 0 && (
								<ul class="mt-4 flex flex-wrap gap-1.5">
									{entry.honours.map((honour) => (
										<li class="chip chip-accent">{honour}</li>
									))}
								</ul>
							)}

							<ul class="mt-5 space-y-2">
								{entry.notes.map((note) => (
									<li class="flex gap-3 text-[15px] leading-relaxed">
										<span class="mt-2 size-1.5 shrink-0 bg-violet" aria-hidden="true" />
										<span class="muted">{note}</span>
									</li>
								))}
							</ul>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section class="shell py-20">
		<SectionTitle label="Recognition" sprite="star" title="Awards" />

		<ul class="grid gap-4 sm:grid-cols-2" data-reveal-group>
			{
				AWARDS.map((award) => (
					<li class="panel panel-lift p-5">
						<div class="flex items-start justify-between gap-4">
							<PixelSprite name="heart" size={20} class="text-hot" data-twitch />
							<span class="font-mono text-[11px] text-amber">{award.year}</span>
						</div>
						<h3 class="display mt-4 text-sm text-paper">{award.title}</h3>
						<p class="muted mt-1 font-mono text-[11px]">{award.issuer}</p>
						{award.note && <p class="muted mt-2 text-sm leading-relaxed">{award.note}</p>}
					</li>
				))
			}
		</ul>
	</section>

	<section class="shell pb-8">
		<div class="panel flex flex-wrap items-center justify-between gap-6 p-8" data-reveal>
			<div>
				<h2 class="display text-lg">AVAILABLE FOR WORK</h2>
				<p class="muted mt-2 text-sm">
					Open to full stack, mobile and UI/UX roles — and to anything that
					treats its users like people.
				</p>
			</div>
			<a href={`mailto:${SITE.email}`} class="btn btn-primary">
				<PixelSprite name="coin" size={12} />
				Get in touch
			</a>
		</div>
	</section>

	<Marquee />
</BaseLayout>