---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostRow from '../../components/PostRow.astro';
import PixelSprite from '../../components/PixelSprite.astro';
import { withBase } from '../../lib/site';
import { blogPostingSchema } from '../../lib/seo';

export async function getStaticPaths() {
	const posts = await getCollection('blog', ({ data }) => !data.draft);
	return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { data } = post;
const { Content } = await render(post);

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);
const index = posts.findIndex((p) => p.id === post.id);
const newer = index > 0 ? posts[index - 1] : undefined;
const older = index < posts.length - 1 ? posts[index + 1] : undefined;

const date = data.pubDate.toLocaleDateString('en-GB', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
});

/** ~200 words a minute, rounded up. */
const minutes = Math.max(1, Math.round((post.body?.split(/\s+/).length ?? 0) / 200));
const words = post.body?.split(/\s+/).filter(Boolean).length ?? 0;
---

<BaseLayout
	title={data.title}
	description={data.description}
	ogType="article"
	publishedTime={data.pubDate}
	modifiedTime={data.updatedDate ?? data.pubDate}
	section="Notebook"
	breadcrumbs={[
		{ name: 'Home', href: withBase('/') },
		{ name: 'Notebook', href: withBase('/blog/') },
		{ name: data.title },
	]}
	schema={[
		blogPostingSchema(Astro.url.href, {
			title: data.title,
			description: data.description,
			pubDate: data.pubDate,
			updatedDate: data.updatedDate,
			tags: data.tags,
			words,
		}),
	]}
>
	<article>
		<header class="border-b-2 border-line bg-ink-2">
			<div class="shell max-w-3xl py-14">
				<a
					href={withBase('/blog/')}
					class="font-mono text-[11px] text-dim transition-colors hover:text-amber"
				>
					← NOTEBOOK
				</a>

				<h1
					class="display mt-8 text-[clamp(1.7rem,6vw,3rem)]"
					aria-label={data.title}
					data-reveal
					data-enter
				>
					<span data-decode data-text={data.title.toUpperCase()} aria-hidden="true">
						{data.title.toUpperCase()}
					</span>
				</h1>

				<p class="lede muted mt-5">{data.description}</p>

				<div
					class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-3 font-mono text-[11px] text-dim"
					data-reveal
				>
					<time datetime={data.pubDate.toISOString()} class="text-paper">
						{date}
					</time>
					<span class="text-line-2">/</span>
					<span>{minutes} MIN READ</span>
					<span class="text-line-2">/</span>
					<span class="flex items-center gap-2 text-phos">
						SCORE
						<span class="inline-block h-2 w-16 bg-ink-4">
							<span
								class="block h-full bg-phos"
								style={`width:${Math.min(100, (data.score / 1000) * 100)}%`}
							>
							</span>
						</span>
						{data.score}
					</span>
				</div>

				<ul class="mt-6 flex flex-wrap gap-2">
					{data.tags.map((tag) => <li class="chip chip-accent">#{tag}</li>)}
				</ul>
			</div>
		</header>

		<div class="shell max-w-3xl py-16">
			<div class="prose-arcade" data-reveal>
				<Content />
			</div>

			<div
				class="panel mt-16 flex items-center gap-4 p-6"
				data-twitch
			>
				<PixelSprite name="crab" size={34} class="bob" />
				<p class="text-sm">
					Written by <strong class="text-phos">Frank Gesmundo</strong> — full
					stack developer building offline-first tools.
					<a href={withBase('/about/')} class="ml-1 text-cyan hover:text-phos">More about me →</a>
				</p>
			</div>
		</div>
	</article>

	<!-- Newer / older -->
	<nav
		aria-label="More posts"
		class="border-t-2 border-line bg-ink-2 py-14"
	>
		<div class="shell grid gap-8 sm:grid-cols-2">
			{
				newer ? (
					<div class="panel p-6" data-reveal>
						<p class="eyebrow mb-3">↑ Newer entry</p>
						<a
							href={withBase(`/blog/${newer.id}/`)}
							class="display text-sm text-paper transition-colors hover:text-amber"
						>
							{newer.data.title}
						</a>
					</div>
				) : (
					<div />
				)
			}
			{
				older && (
					<div class="panel p-6 sm:text-right" data-reveal>
						<p class="eyebrow mb-3">Older entry ↓</p>
						<a
							href={withBase(`/blog/${older.id}/`)}
							class="display text-sm text-paper transition-colors hover:text-amber"
						>
							{older.data.title}
						</a>
					</div>
				)
			}
		</div>
	</nav>
</BaseLayout>
